---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Nesc — Software & Robotics",
  description = "Nesc's personal site & blog on software engineering, robotics, and minimalist design.",
} = Astro.props;

const pathname = new URL(Astro.request.url).pathname;

// Dynamic Header Title (jkwon.co feature: displays Nesc on home, and section name when navigated)
function getHeaderTitle(path: string) {
  if (path === '/' || path === '') return 'Nesc';
  if (path.startsWith('/about')) return 'About';
  if (path.startsWith('/projects')) return 'Projects';
  if (path.startsWith('/posts')) return 'Writing';
  if (path.startsWith('/timeline')) return 'Timeline';
  if (path.startsWith('/contact')) return 'Contact';
  if (path.startsWith('/gear')) return 'Gear';
  return 'Nesc';
}

const headerTitle = getHeaderTitle(pathname);

// All navigation menu items in English
const navItems = [
  { path: '/', label: 'Home' },
  { path: '/about', label: 'About' },
  { path: '/projects', label: 'Projects' },
  { path: '/posts', label: 'Writing' },
  { path: '/timeline', label: 'Timeline' },
  { path: '/contact', label: 'Contact ↗' },
];
---

<!xhtml>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Google Fonts (Newsreader Serif + Noto Sans SC 思源黑体 + JetBrains Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Noto+Sans+SC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- View Transitions -->
    <ViewTransitions />

    <!-- Theme Inline Script -->
    <script is:inline>
      function getInitialTheme() {
        const stored = localStorage.getItem('theme');
        if (stored) return stored;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      const theme = getInitialTheme();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body>
    <div class="home-wrapper">
      <div class="home-container">
        <!-- Left Sidebar -->
        <aside class="sidebar">
          <header class="flex items-center justify-between w-full">
            <h1>
              <a href="/" class="hover:opacity-80 transition-opacity">{headerTitle}</a>
            </h1>

            <!-- Dark Theme Switcher -->
            <button
              id="theme-toggle"
              type="button"
              aria-label="Toggle theme"
              class="p-1.5 rounded text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
            >
              <svg id="theme-toggle-light-icon" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <svg id="theme-toggle-dark-icon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
            </button>
          </header>

          <nav>
            <ul>
              {navItems.map((item) => {
                const isActive = pathname === item.path || (item.path !== '/' && pathname.startsWith(item.path));
                return (
                  <li>
                    <a href={item.path} class={isActive ? 'active' : ''}>
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        </aside>

        <!-- Main Page Content -->
        <main class="page-content">
          <slot />
        </main>
      </div>
    </div>

    <script>
      function setupThemeToggle() {
        const toggleBtn = document.getElementById('theme-toggle');
        if (!toggleBtn) return;

        toggleBtn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.contains('dark');
          if (isDark) {
            document.documentElement.classList.remove('dark');
            localStorage.setItem('theme', 'light');
          } else {
            document.documentElement.classList.add('dark');
            localStorage.setItem('theme', 'dark');
          }
        });
      }

      setupThemeToggle();
      document.addEventListener('astro:after-swap', setupThemeToggle);
    </script>
  </body>
</html>
