---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Nescript — Software & Robotics",
  description = "Nescript's personal site & blog on software engineering, robotics, and minimalist design.",
} = Astro.props;

const pathname = new URL(Astro.request.url).pathname;

// Dynamic Header Title
function getHeaderTitle(path: string) {
  if (path === '/' || path === '') return 'Nescript';
  if (path.startsWith('/about')) return 'About';
  if (path.startsWith('/projects')) return 'Projects';
  if (path.startsWith('/articles')) return 'Articles';
  if (path.startsWith('/thoughts')) return 'Thoughts';
  if (path.startsWith('/contact')) return 'Contact';
  if (path.startsWith('/gear')) return 'Gear';
  return 'Nescript';
}

const headerTitle = getHeaderTitle(pathname);

// All navigation menu items in English
const navItems = [
  { path: '/', label: 'Home' },
  { path: '/about', label: 'About' },
  { path: '/projects', label: 'Projects' },
  { path: '/articles', label: 'Articles' },
  { path: '/thoughts', label: 'Thoughts' },
  { path: '/contact', label: 'Contact ↗' },
];
---

<!xhtml>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Google Fonts (EB Garamond + Noto Serif SC 思源宋体 + JetBrains Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Noto+Serif+SC:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- View Transitions -->
    <ViewTransitions />
  </head>
  <body>
    <div class="home-wrapper">
      <div class="home-container">
        <!-- Left Sidebar -->
        <aside class="sidebar" transition:persist>
          <header class="flex items-center justify-between w-full">
            <h1>
              <a href="/" class="hover:opacity-80 transition-opacity">{headerTitle}</a>
            </h1>
          </header>

          <nav>
            <ul>
              {navItems.map((item) => {
                const isActive = pathname === item.path || (item.path !== '/' && pathname.startsWith(item.path));
                return (
                  <li>
                    <a href={item.path} class={isActive ? 'active' : ''}>
                      {item.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
        </aside>

        <!-- Main Page Content -->
        <main class="page-content">
          <slot />
        </main>
      </div>
    </div>

    <script>
      function updateSidebarState() {
        const pathname = window.location.pathname;

        // 1. Update Header Title (Home -> Nesc, Writing -> Writing, etc.)
        const headerLink = document.querySelector('.home-container .sidebar header h1 a');
        if (headerLink) {
          let title = 'Nescript';
          if (pathname.startsWith('/about')) title = 'About';
          else if (pathname.startsWith('/projects')) title = 'Projects';
          else if (pathname.startsWith('/articles')) title = 'Articles';
          else if (pathname.startsWith('/thoughts')) title = 'Thoughts';
          else if (pathname.startsWith('/contact')) title = 'Contact';
          else if (pathname.startsWith('/gear')) title = 'Gear';

          headerLink.textContent = title;
        }

        // 2. Update Active Nav Class
        const navLinks = document.querySelectorAll('.home-container nav ul li a');
        navLinks.forEach((link) => {
          const href = link.getAttribute('href');
          if (!href) return;

          const isActive =
            href === '/'
              ? pathname === '/' || pathname === ''
              : pathname.startsWith(href);

          if (isActive) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }

      document.addEventListener('astro:page-load', updateSidebarState);

      /* ---- 右侧容器动态垂直居中 ---- */
      function centerContent() {
        const content = document.querySelector('main.page-content');
        if (!content) return;

        // 移动端 (<= 768px) 不执行任何垂直居中逻辑，保持标准响应式流式布局
        if (window.innerWidth <= 768) {
          content.style.marginTop = '';
          return;
        }

        const vh = window.innerHeight;
        const centerTarget = content.querySelector('[data-center-target]');
        const contentH = centerTarget ? centerTarget.offsetHeight : content.scrollHeight;
        const padding = 80; /* 上下安全留白 */

        if (contentH + padding * 2 >= vh) {
          /* 内容超高，不居中，与左侧导航栏保持同一基线 */
          content.style.marginTop = '';
        } else {
          /* Home 页用光学中心偏上 (2.5)，其他页面用数学中心 (2) */
          const isHome = window.location.pathname === '/' || window.location.pathname === '';
          const divisor = isHome ? 2.5 : 2;
          const offset = Math.max(0, (vh - contentH) / divisor - padding);
          content.style.marginTop = offset + 'px';
        }
      }

      document.addEventListener('astro:page-load', centerContent);
      window.addEventListener('resize', centerContent);
      window.centerContent = centerContent;
    </script>
  </body>
</html>
