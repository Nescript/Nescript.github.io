---
import Layout from '../layouts/Layout.astro';

const timelineEvents = [
  {
    year: '2026',
    title: 'Robotics Trajectory Optimization Research',
    category: 'Research',
    description: 'Developed real-time C++20 minimum-jerk trajectory planners and obstacle avoidance for mobile robots.',
  },
  {
    year: '2025',
    title: 'Graduated B.S. in Robotics Engineering',
    category: 'Education',
    description: 'Specialized in state estimation, Kalman filtering, ROS 2, and embedded Linux.',
  },
  {
    year: '2024',
    title: 'Open Source Minimalist Blog Engine',
    category: 'Open Source',
    description: 'Designed and built high-performance Astro static site templates with KaTeX and Shiki.',
  },
  {
    year: '2023',
    title: 'State Estimator & EKF Development',
    category: 'Engineering',
    description: 'Implemented extended Kalman filter for IMU, wheel odometry, and LiDAR sensor fusion.',
  },
];
---

<Layout title="Timeline — Nesc" description="Career milestones and experience timeline.">
  <div class="space-y-8">
    <div class="space-y-2 border-b border-zinc-200/60 dark:border-zinc-800/60 pb-6">
      <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        Timeline
      </h1>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">
        Milestones, research, and technical journey
      </p>
    </div>

    <div class="space-y-8 border-l border-zinc-200/80 dark:border-zinc-800/80 pl-4 sm:pl-6 ml-2">
      {timelineEvents.map((event) => (
        <div class="relative space-y-1.5 group">
          <!-- Dot on Timeline -->
          <div class="absolute -left-[21px] sm:-left-[29px] top-1 w-2.5 h-2.5 rounded-full bg-zinc-300 dark:bg-zinc-700 border-2 border-white dark:border-zinc-900 group-hover:bg-zinc-900 dark:group-hover:bg-zinc-100 transition-colors"></div>

          <div class="flex items-baseline justify-between">
            <h2 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
              {event.title}
            </h2>
            <span class="text-xs font-mono text-zinc-400 shrink-0 ml-4">{event.year}</span>
          </div>

          <span class="inline-block text-[10px] font-mono uppercase tracking-wider text-zinc-400">
            {event.category}
          </span>

          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed pt-1">
            {event.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</Layout>
