---
import Layout from '../layouts/Layout.astro';

const timelineEvents = [
  {
    date: '2026-07-14',
    title: 'pku-compiler',
    category: 'Project / Compiler',
    description: '我正在学习 PKU 的编译原理实践，旨在实现一个从 SysY 编译到 RISC-V 汇编的编译器。我同时在这个项目中探索 AI 时代的学习方式。',
    link: 'https://github.com/Nescript/pku-compiler',
  },
  {
    date: '2026-06-15',
    title: 'rm_controllers (refactor)',
    category: 'Project / Control Architecture',
    description: '对程序设计架构的探索，我将轮腿控制器的核心算法与 ROS 解耦，便于未来的迁移。',
    link: 'https://github.com/Nescript/rm_controllers/tree/refactor',
  },
  {
    date: '2026-01-25',
    title: 'balance_car_ws',
    category: 'Project / Control Theory',
    description: '我的平衡车101，分别实现了串级 PID 控制和 LQR 控制。',
    link: 'https://github.com/Nescript/balance_car_ws',
  },
  {
    date: '2026-01-08',
    title: '文章：从学习 XML 开始编写 xacro 和 urdf',
    category: 'Blog / ROS',
    description: '撰写机器人统一描述文件 URDF、Xacro 宏定义、XML 语法基础与 Gazebo 仿真配置指南。',
    link: '/posts/xml-xacro-urdf',
  },
  {
    date: '2025-12-31',
    title: '文章：用 CAN 协议驱动电机并接收回馈',
    category: 'Blog / Embedded',
    description: '解析 CAN 总线协议分时复用原理，包含 M3508 电机与 C620 电调控制报文解析与反馈数据换算。',
    link: '/posts/can-motor-driver',
  },
  {
    date: '2025-12-25',
    title: '文章：多线程开发理论与实践',
    category: 'Blog / C++',
    description: '梳理 C++11 多线程编程、进程与线程区别、std::thread 基础及 join 与 detach 资源管理。',
    link: '/posts/multithread-development',
  },
  {
    date: '2025-11-25',
    title: 'sentry_chassis_controller',
    category: 'Project / ROS Control',
    description: '我的 ROS 101，在这里我实现了舵轮底盘的控制，包括运动学正逆解算，动力学解算，以及功率计算与控制等功能。',
    link: 'https://github.com/Nescript/sentry_chassis_controller',
  },
];
---

<Layout title="Timeline — Nescript" description="Chronological timeline of projects, practices, and writing by Nescript.">
  <div class="space-y-6 w-full max-w-prose">
    <div class="space-y-6 border-l border-zinc-200/80 dark:border-zinc-800/80 pl-4 sm:pl-6 ml-2">
      {timelineEvents.map((event) => (
        <div class="relative space-y-1 group">
          <!-- Timeline Dot -->
          <div class="absolute -left-[21px] sm:-left-[29px] top-1.5 w-2.5 h-2.5 rounded-full bg-zinc-300 dark:bg-zinc-700 border-2 border-white dark:border-zinc-900 group-hover:bg-blue-500 transition-colors"></div>

          <div class="flex items-baseline justify-between gap-2">
            <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 font-sans">
              {event.link.startsWith('http') ? (
                <a href={event.link} target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 dark:hover:text-blue-400 hover:underline">
                  {event.title} <span class="text-xs">↗</span>
                </a>
              ) : (
                <a href={event.link} class="hover:text-blue-600 dark:hover:text-blue-400 hover:underline">
                  {event.title}
                </a>
              )}
            </h2>
            <span class="text-xs font-mono text-zinc-400 shrink-0">{event.date}</span>
          </div>

          <span class="inline-block text-[10px] font-mono uppercase tracking-wider text-zinc-400">
            {event.category}
          </span>

          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-serif pt-0.5">
            {event.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</Layout>
