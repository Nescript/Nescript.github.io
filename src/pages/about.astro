---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — Nesc" description="About Nesc — software engineer & robotics researcher.">
  <div class="space-y-6 w-full">
    <h2 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-zinc-100 border-b border-zinc-200/60 dark:border-zinc-800/60 pb-3">
      About Me
    </h2>

    <div class="space-y-4 text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">
      <p>
        Hi! I'm Nesc. I specialize in robotics software, C++ systems programming, state estimation, and building minimal web applications.
      </p>
      <p>
        I focus on clean architecture, precision engineering, and minimalist design aesthetics.
      </p>
    </div>

    <div class="space-y-2 pt-4 border-t border-zinc-200/60 dark:border-zinc-800/60 text-xs">
      <h3 class="font-bold text-zinc-900 dark:text-zinc-100">Connect</h3>
      <div class="flex items-center gap-3 text-zinc-500">
        <a href="https://github.com/nesc" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">GitHub ↗</a>
        <span>/</span>
        <a href="mailto:nesc@example.com" class="text-blue-600 dark:text-blue-400 hover:underline">Email ↗</a>
      </div>
    </div>
  </div>
</Layout>
