---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Writing — Nesc" description="Technical writing, math, and robotics thoughts.">
  <div class="space-y-6 w-full">
    <h2 class="text-xl sm:text-2xl font-semibold text-zinc-900 dark:text-zinc-100 font-sans border-b border-zinc-200/60 dark:border-zinc-800/60 pb-3">
      Writing (Thoughts)
    </h2>

    <div class="divide-y divide-zinc-200/60 dark:divide-zinc-800/60">
      {posts.map((post) => (
        <article class="py-3.5 first:pt-0 last:pb-0">
          <div class="flex items-baseline justify-between gap-2">
            <a
              href={`/posts/${post.slug}`}
              class="text-base font-semibold text-blue-600 dark:text-blue-400 hover:underline font-sans"
            >
              {post.data.title}
            </a>
            <time class="text-xs font-mono text-zinc-400 shrink-0">
              {post.data.date.toISOString().split('T')[0]}
            </time>
          </div>
          {post.data.description && (
            <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1 font-serif">
              {post.data.description}
            </p>
          )}
        </article>
      ))}
    </div>
  </div>
</Layout>
