---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Articles — Nescript" description="Technical writing, math, and robotics articles.">
  <div class="space-y-6 w-full max-w-prose">
    <div class="space-y-5">
      {posts.map((post) => (
        <article class="space-y-1.5 border-b border-zinc-200/50 dark:border-zinc-800/50 pb-4">
          <div>
            <a
              href={`/articles/${post.slug}`}
              class="text-base font-medium text-[var(--accent-blue)] hover:underline font-sans"
            >
              <span class="text-zinc-400 font-normal">[{post.data.date.toISOString().split('T')[0]}]</span>{' '}
              {post.data.title}
            </a>
          </div>
          {post.data.description && (
            <p class="text-sm text-zinc-600 dark:text-zinc-400 font-serif leading-relaxed">
              {post.data.description}
            </p>
          )}
        </article>
      ))}
    </div>
  </div>
</Layout>
