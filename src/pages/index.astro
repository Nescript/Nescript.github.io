---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout title="Nesc — 软件与机器人">
  <div class="space-y-8 w-full">
    <!-- Bio Intro -->
    <div class="space-y-3">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        软件工程师 & 机器人研究员
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
        专注于 C++20 轨迹规划算法、实时状态估计（EKF/UKF）与极简 Web 系统架构。致力于高精尖工程实现与极简美学的融合。
      </p>
    </div>

    <!-- Quick Overview / Latest Thoughts -->
    <div class="space-y-4 pt-4 border-t border-zinc-200/60 dark:border-zinc-800/60">
      <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100">
        最新文章 (Writing)
      </h3>

      <div class="space-y-3">
        {posts.map((post) => (
          <div class="space-y-1">
            <div class="flex items-baseline justify-between">
              <a
                href={`/posts/${post.slug}`}
                class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline"
              >
                {post.data.title}
              </a>
              <span class="text-xs font-mono text-zinc-400">
                {post.data.date.toISOString().split('T')[0]}
              </span>
            </div>
            {post.data.description && (
              <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2">
                {post.data.description}
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
