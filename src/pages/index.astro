---
import Layout from '../layouts/Layout.astro';

// 构建时获取最新漫画编号（服务端，无 CORS 限制）
let maxComic = 3050;
try {
  const res = await fetch('https://xkcd.com/info.0.json');
  if (res.ok) {
    const data = await res.json();
    maxComic = data.num;
  }
} catch (_) {}
---

<Layout title="Nescript — Home">
  <div class="flex flex-col items-center justify-center space-y-4 w-full">
    <div data-center-target id="comic-container" class="p-3 border border-[var(--border-color)] rounded-xl bg-[var(--card-bg)] shadow-sm max-w-xl">
      <img
        id="comic-img"
        src="/images/xkcd_grownups.png"
        alt="xkcd"
        class="w-full max-w-xl h-auto"
      />
    </div>
    <span id="comic-caption" class="text-xs font-mono text-zinc-400">
      Comic from <a href="https://xkcd.com/" target="_blank" rel="noopener noreferrer" class="underline hover:text-blue-500">xkcd</a>
    </span>
  </div>
</Layout>

<script define:vars={{ maxComic }}>
  function loadDailyComic() {
    const img = document.getElementById('comic-img');
    const caption = document.getElementById('comic-caption');
    if (!img || !caption) return;

    /* 用今天的日期生成固定种子，同一天始终显示同一幅漫画 */
    const today = new Date();
    const daySeed = today.getFullYear() * 10000 + (today.getMonth() + 1) * 100 + today.getDate();

    /* 简单正弦哈希伪随机 */
    const x = Math.sin(daySeed + 1) * 10000;
    const rand = x - Math.floor(x);
    const comicNum = Math.floor(rand * (maxComic - 1)) + 1;

    /* 通过 CORS 代理获取漫画元数据 */
    fetch('https://corsproxy.io/?' + encodeURIComponent('https://xkcd.com/' + comicNum + '/info.0.json'))
      .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(data => {
        img.src = data.img;
        img.alt = data.alt || data.title;
        img.title = data.alt || '';
        caption.innerHTML =
          '<a href="https://xkcd.com/' + comicNum + '/" target="_blank" rel="noopener noreferrer" class="underline hover:text-blue-500">#' + comicNum + ': ' + data.title + '</a>' +
          ' — from <a href="https://xkcd.com/" target="_blank" rel="noopener noreferrer" class="underline hover:text-blue-500">xkcd</a>';

        /* 图片加载后重新计算居中 */
        img.onload = () => {
          if (typeof centerContent === 'function') centerContent();
        };
      })
      .catch(() => {
        /* 加载失败时保留默认 grownups 图片 */
      });
  }

  document.addEventListener('astro:page-load', loadDailyComic);
</script>
