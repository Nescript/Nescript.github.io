---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'pku-compiler',
    description: '我正在学习的 PKU 编译原理实践，旨在实现一个从 SysY 编译到 RISC-V 汇编的编译器。我同时在这个项目中探索 AI 时代的学习方式。',
    link: 'https://github.com/Nescript/pku-compiler',
    startDate: '2026-07-14',
  },
  {
    title: 'Bipedal wheel controller (refactor branch)',
    description: '对程序设计架构的探索，我将轮腿控制器的核心与 ROS 解耦，便于未来的迁移。',
    link: 'https://github.com/Nescript/rm_controllers/tree/refactor',
    startDate: '2026-06-15',
  },
  {
    title: 'Balance controller',
    description: '我的平衡车101，分别实现了串级 PID 控制和 LQR 控制。',
    link: 'https://github.com/Nescript/balance_car_ws',
    startDate: '2026-01-25',
  },
  {
    title: 'Sentry chassis controller',
    description: '我的 ROS 101。在这里我实现了舵轮底盘的控制，包括运动学正逆解算，动力学解算，以及功率计算与控制等功能。',
    link: 'https://github.com/Nescript/sentry_chassis_controller',
    startDate: '2025-11-25',
  },
];
---

<Layout title="Projects — Nescript" description="Projects and engineering practices by Nescript.">
  <div class="space-y-6 w-full max-w-prose">
    <div class="space-y-5">
      {projects.map((project) => (
        <div class="space-y-1.5 border-b border-zinc-200/50 dark:border-zinc-800/50 pb-4">
          <div>
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="text-base font-semibold text-blue-600 dark:text-blue-400 hover:underline font-sans flex items-center gap-1"
            >
              <span class="font-mono text-zinc-400 font-normal">[{project.startDate}]</span>{' '}
              <span>{project.title}</span>
              <span class="text-xs">↗</span>
            </a>
          </div>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 font-serif leading-relaxed">
            {project.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</Layout>
