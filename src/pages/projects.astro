---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'pku-compiler',
    description: 'A PKU compiler principles practice project I am currently studying, aiming to build a compiler from SysY to RISC-V assembly. I am also exploring learning methods in the AI era through this project.',
    link: 'https://github.com/Nescript/pku-compiler',
    startDate: '2026-07-14',
  },
  {
    title: 'Bipedal wheel controller (refactor branch)',
    description: 'An exploration of software architecture: I decoupled the core of the wheel-legged controller from ROS to make future migration easier.',
    link: 'https://github.com/Nescript/rm_controllers/tree/refactor',
    startDate: '2026-06-15',
  },
  {
    title: 'Balance controller',
    description: 'My balance car 101, implementing both cascaded PID control and LQR control.',
    link: 'https://github.com/Nescript/balance_car_ws',
    startDate: '2026-01-25',
  },
  {
    title: 'Sentry chassis controller',
    description: 'My ROS 101. I implemented control for a steering-wheel chassis, including forward and inverse kinematics, dynamics, and power calculation and control.',
    link: 'https://github.com/Nescript/sentry_chassis_controller',
    startDate: '2025-11-25',
  },
];
---

<Layout title="Projects — Nescript" description="Projects and engineering practices by Nescript.">
  <div class="space-y-6 w-full max-w-prose">
    <div class="space-y-5">
      {projects.map((project) => (
        <div class="space-y-1.5 border-b border-[var(--border-color)] pb-4">
          <div>
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="text-base font-semibold text-[var(--accent-blue)] hover:underline flex items-center gap-1"
            >
              <span class="text-zinc-400 font-normal">[{project.startDate}]</span>{' '}
              <span>{project.title}</span>
            </a>
          </div>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            {project.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</Layout>
