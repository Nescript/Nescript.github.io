---
import Layout from '../layouts/Layout.astro';

const contactInfo = {
  email: 'raymond059@mails.edu.gdut.cn',
  github: 'https://github.com/nescript',
  githubUser: 'nescript',
  location: 'Guangzhou, China',
};
---

<Layout title="Contact — Nescript" description="Contact details and profiles for Nescript.">
  <div class="space-y-6 w-full max-w-prose">
    <div class="space-y-4 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 font-serif">
      <p>
        Feel free to reach out.
      </p>

      <div class="pt-2 space-y-3 font-sans">
        <!-- Email Item -->
        <div class="flex items-center justify-between py-2 border-b border-zinc-200/60 dark:border-zinc-800/60">
          <span class="text-xs font-mono text-zinc-400 uppercase tracking-wider">Email</span>
          <div class="flex items-center gap-3">
            <a
              href={`mailto:${contactInfo.email}`}
              class="text-sm font-mono text-[var(--accent-blue)] hover:underline"
            >
              {contactInfo.email}
            </a>
            <button
              id="copy-email-btn"
              data-email={contactInfo.email}
              class="px-2 py-0.5 text-xs font-mono rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-500 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
            >
              Copy
            </button>
          </div>
        </div>

        <!-- GitHub Item -->
        <div class="flex items-center justify-between py-2 border-b border-zinc-200/60 dark:border-zinc-800/60">
          <span class="text-xs font-mono text-zinc-400 uppercase tracking-wider">GitHub</span>
          <a
            href={contactInfo.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-mono text-[var(--accent-blue)] hover:underline flex items-center gap-1"
          >
            <span>@{contactInfo.githubUser}</span>
            <span class="text-xs">↗</span>
          </a>
        </div>

        <!-- Location Item -->
        <div class="flex items-center justify-between py-2 border-b border-zinc-200/60 dark:border-zinc-800/60">
          <span class="text-xs font-mono text-zinc-400 uppercase tracking-wider">Location</span>
          <span class="text-sm font-mono text-zinc-600 dark:text-zinc-400">{contactInfo.location}</span>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function setupCopyEmail() {
    const copyBtn = document.getElementById('copy-email-btn');
    if (!copyBtn) return;

    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email');
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        copyBtn.innerText = 'Copied!';
        copyBtn.classList.add('bg-emerald-500', 'text-white');
        setTimeout(() => {
          copyBtn.innerText = 'Copy';
          copyBtn.classList.remove('bg-emerald-500', 'text-white');
        }, 2000);
      } catch (e) {
        copyBtn.innerText = 'Failed';
      }
    });
  }

  setupCopyEmail();
  document.addEventListener('astro:after-swap', setupCopyEmail);
  document.addEventListener('astro:page-load', setupCopyEmail);
</script>
