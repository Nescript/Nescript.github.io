---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Filter to h2 and h3
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <nav class="toc-container text-xs font-sans tracking-wide">
    <div class="font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 mb-3 px-2">
      On This Page
    </div>
    <ul class="space-y-1.5 border-l border-zinc-200 dark:border-zinc-800">
      {filteredHeadings.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            data-toc-link
            data-heading-id={heading.slug}
            class={`block py-1 transition-all duration-200 border-l -ml-px ${
              heading.depth === 3 ? 'pl-6' : 'pl-3'
            } text-zinc-500 dark:text-zinc-400 border-transparent hover:text-zinc-900 dark:hover:text-zinc-100 hover:border-zinc-400 dark:hover:border-zinc-500`}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  function setupTOC() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            if (!id) return;

            document.querySelectorAll('[data-toc-link]').forEach((link) => {
              const linkHeadingId = link.getAttribute('data-heading-id');
              if (linkHeadingId === id) {
                link.classList.add('text-zinc-900', 'dark:text-zinc-100', 'border-zinc-900', 'dark:border-zinc-100', 'font-medium');
                link.classList.remove('text-zinc-500', 'dark:text-zinc-400', 'border-transparent');
              } else {
                link.classList.remove('text-zinc-900', 'dark:text-zinc-100', 'border-zinc-900', 'dark:border-zinc-100', 'font-medium');
                link.classList.add('text-zinc-500', 'dark:text-zinc-400', 'border-transparent');
              }
            });
          }
        });
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: 0.1 }
    );

    // Observe all h2 and h3 elements inside the article
    const headings = document.querySelectorAll('article h2[id], article h3[id]');
    headings.forEach((heading) => observer.observe(heading));
  }

  setupTOC();
  document.addEventListener('astro:after-swap', setupTOC);
</script>
