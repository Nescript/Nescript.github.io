<script>
  function detectLanguage(pre) {
    const code = pre.querySelector('code');
    if (!code) return '';

    // Shiki / markdown-it usually add a "language-xxx" class
    const langClass = Array.from(code.classList).find((c) => c.startsWith('language-'));
    if (langClass) return langClass.replace('language-', '');

    // Fallback to data-language attribute if present
    const dataLang = pre.getAttribute('data-language') || code.getAttribute('data-language');
    if (dataLang) return dataLang;

    return '';
  }

  function setupCopyButtons() {
    const codeBlocks = document.querySelectorAll('pre');

    codeBlocks.forEach((codeBlock) => {
      // Skip if already processed or if it belongs to KaTeX
      if (codeBlock.querySelector('.copy-code-button')) return;
      if (codeBlock.closest('.katex-display')) return;

      const container = document.createElement('div');
      container.className = 'code-block-wrapper relative group/code';

      codeBlock.parentNode?.insertBefore(container, codeBlock);
      container.appendChild(codeBlock);

      // Language label
      const language = detectLanguage(codeBlock);
      if (language) {
        const langLabel = document.createElement('span');
        langLabel.className = 'code-language-label';
        langLabel.textContent = language;
        container.appendChild(langLabel);
      }

      const copyBtn = document.createElement('button');
      copyBtn.className = 'copy-code-button';
      copyBtn.innerText = 'Copy';
      copyBtn.setAttribute('aria-label', 'Copy code to clipboard');

      let resetTimeout;

      copyBtn.addEventListener('click', async () => {
        clearTimeout(resetTimeout);
        const codeText = codeBlock.querySelector('code')?.innerText || codeBlock.innerText;
        try {
          await navigator.clipboard.writeText(codeText);
          copyBtn.innerText = 'Copied';
          copyBtn.classList.remove('is-failed');
          copyBtn.classList.add('is-copied');
          resetTimeout = setTimeout(() => {
            copyBtn.innerText = 'Copy';
            copyBtn.classList.remove('is-copied');
          }, 2000);
        } catch (err) {
          copyBtn.innerText = 'Failed';
          copyBtn.classList.remove('is-copied');
          copyBtn.classList.add('is-failed');
          resetTimeout = setTimeout(() => {
            copyBtn.innerText = 'Copy';
            copyBtn.classList.remove('is-failed');
          }, 2000);
        }
      });

      container.appendChild(copyBtn);
    });
  }

  setupCopyButtons();
  document.addEventListener('astro:after-swap', setupCopyButtons);
</script>
